# ---- Postgres (docker compose)
POSTGRES_USER=mypersonalfinance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mypersonalfinance

# ---- API
# Local development (pnpm dev) uses the database from docker-compose.dev.yml.
DATABASE_URL=postgres://mypersonalfinance:change-me@localhost:5432/mypersonalfinance
API_PORT=3000
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# true when served over HTTPS
COOKIE_SECURE=false
# Public URL of the web app (used in invitation links)
WEB_ORIGIN=http://localhost:5173

# ---- Production (docker compose)
WEB_PORT=8080
